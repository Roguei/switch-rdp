# switch_rdp settings  (SD:/switch_rdp.cfg)
# 一行一个 key = value，UTF-8，可在 PC 上直接编辑
#
# 界面上按 + 保存下面四项；把隐藏服务器的信息填进界面后同时按 + 和 -，
# 当前字段会存进 alt_*，界面随即恢复成已保存的可见配置。
server =
port = 3389
user = administrator
pass =

# alt_* 备用配置：秘籍（上上下下左右左右 B A）用它连接
alt_server =
alt_port = 3389
alt_user = administrator
alt_pass =

# 0x001D（位图能力集）的处理方式：drop / empty / keep
codecs = drop
